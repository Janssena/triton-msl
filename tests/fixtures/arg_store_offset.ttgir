  tt.func public @argmax_g(%X: !tt.ptr<f32> {tt.divisibility = 16 : i32} , %O: !tt.ptr<i32> {tt.divisibility = 16 : i32} ) attributes {noinline = false} {
    %c64_i32 = arith.constant 64 : i32 
